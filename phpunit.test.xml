<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/UnitTestBootstrap.php">
    <testsuites>
        <testsuite name="Unit Tests (No DB)">
            <directory>tests/Unit</directory>
            <env name="APP_ENV" value="testing"/>
            <env name="DB_SERVER" value="127.0.0.1"/>
            <env name="DB_NAME" value="inoerp_test"/>
            <env name="DB_USER" value=""/>
            <env name="DB_PASS" value=""/>
        </testsuite>
        <testsuite name="Integration Tests">
            <directory>tests/Integration</directory>
            <env name="APP_ENV" value="testing"/>
            <env name="DB_SERVER" value="localhost"/>
            <env name="DB_NAME" value="inoerp_test"/>
            <env name="DB_USER" value="test_user"/>
            <env name="DB_PASS" value="test_pass"/>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist processUncoveredFilesFromWhitelist="true">
            <directory suffix=".php">inoerp/includes</directory>
            <directory suffix=".php">inoerp/modules</directory>
            <directory suffix=".php">inoerp/extensions</directory>
            <exclude>
                <directory>inoerp/tparty</directory>
                <directory>inoerp/engine/install</directory>
            </exclude>
        </whitelist>
    </filter>
    <logging>
        <log type="coverage-html" target="build/coverage" lowUpperBound="35" highLowerBound="70"/>
        <log type="coverage-clover" target="build/coverage.xml"/>
    </logging>
</phpunit>