<?xml version="1.0"?>
<psalm
    totallyTyped="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="inoerp/includes" />
        <directory name="inoerp/modules" />
        <directory name="inoerp/extensions" />
        <ignoreFiles>
            <directory name="inoerp/tparty" />
            <directory name="inoerp/engine/install" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <LessSpecificReturnType errorLevel="suppress" />
        <LessSpecificReturnStatement errorLevel="suppress" />
        <LessSpecificMethodOverride errorLevel="suppress" />
        <MissingReturnType errorLevel="suppress" />
        <MissingParamType errorLevel="suppress" />
        <MissingPropertyType errorLevel="suppress" />
        <UndefinedVariable errorLevel="suppress" />
        <UndefinedClass errorLevel="suppress" />
        <UndefinedMethod errorLevel="suppress" />
        <UndefinedFunction errorLevel="suppress" />
        <UndefinedPropertyFetch errorLevel="suppress" />
        <PropertyNotSetInConstructor errorLevel="suppress" />
        <MixedAssignment errorLevel="suppress" />
        <MixedArgument errorLevel="suppress" />
        <MixedArrayAccess errorLevel="suppress" />
        <MixedArrayOffsetAccess errorLevel="suppress" />
        <MixedInferredPropertyType errorLevel="suppress" />
        <MixedArgumentWithStrictTypes errorLevel="suppress" />
    </issueHandlers>
</psalm>