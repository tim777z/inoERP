# inoERP Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database
DB_SERVER=localhost
DB_NAME=inoerp
DB_USER=inoerp_user
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_PORT=3306
DB_CHARSET=utf8mb4

# Secondary Database (optional)
DB_SERVER2=
DB_NAME2=
DB_USER2=
DB_PASS2=

# Mail Settings
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="inoERP"

# Security
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
JWT_SECRET=
SESSION_LIFETIME=120

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Cache
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# File Storage
FILESYSTEM_DRIVER=local