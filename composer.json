{
    "name": "inoerp/inoerp",
    "description": "inoERP - Open Source ERP System",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "inoERP Team",
            "email": "info@inoerp.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-xml": "*",
        "ext-curl": "*",
        "ext-zip": "*",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "phpmailer/phpmailer": "^6.8",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.25",
        "dompdf/dompdf": "^2.0",
        "setasign/fpdi-fpdf": "^2.3",
        "setasign/fpdf": "^1.8",
        "google/auth": "^1.30",
        "firebase/php-jwt": "^6.8",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.40",
        "psalm/plugin-phpunit": "^2.1",
        "vimeo/psalm": "^5.20"
    },
    "autoload": {
        "psr-4": {
            "InoERP\\": "src/"
        },
        "files": [
            "inoerp/includes/functions/functions.inc",
            "inoerp/includes/basics/basics.inc"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "InoERP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "phpcs --standard=PSR12 inoerp/",
        "lint:fix": "phpcbf --standard=PSR12 inoerp/",
        "static-analysis": "phpstan analyse inoerp/ --level=5",
        "psalm": "psalm --show-info=false",
        "cs-fix": "php-cs-fixer fix inoerp/ --rules=@PSR12"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}